#############################################
# Strava application environment variables
# Copy this file to `.env` and fill the values before running the app.
# Do NOT commit your `.env` with real tokens to a public repo.
#############################################

# Strava credentials (required)
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here

# Optional: after completing the OAuth flow these will be written automatically
# by the app when you exchange the authorization code.
STRAVA_REFRESH_TOKEN=your_refresh_token_here   # (optional - written by app)
STRAVA_ACCESS_TOKEN=your_access_token_here     # (optional - written by app)

# Authorization code (one-time, not required to store)
STRAVA_AUTH_CODE=authorization_code_if_you_want_to_store_it

#############################################
# Other optional keys
#############################################
GEMINI_API_KEY=

